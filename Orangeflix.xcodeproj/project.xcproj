            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/liblz4.1.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/liblzma.5.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libmp3lame.0.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libmpg123.0.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libmpv.2.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libmujs.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libopus.0.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libpcre2-8.0.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libplacebo.387.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libpng16.16.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/librubberband.3.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libsamplerate.0.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libshaderc_shared.1.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libssl.4.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libswresample.7.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libswscale.10.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libuchardet.0.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libudfread.3.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libunibreak.8.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libvmaf.3.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libvpx.12.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libvulkan.1.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libx264.165.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libx265.217.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libzimg.2.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libzstd.1.dylib",
          ],
          "shell": "/bin/sh",
          "script": [
            "set -eu",
            "src=\"$PROJECT_DIR/Vendor/libmpv/lib\"",
            "if [ ! -e \"$src/libmpv.dylib\" ]; then echo 'error: libmpv fehlt; scripts/vendor-libmpv.sh ausführen'; exit 1; fi",
            "dst=\"$TARGET_BUILD_DIR/$FRAMEWORKS_FOLDER_PATH\"",
            "mkdir -p \"$dst\"",
            "for f in \"$src\"/*.dylib; do",
            "  [ -L \"$f\" ] && continue",
            "  name=$(basename \"$f\")",
            "  if [ \"$dst/$name\" -nt \"$f\" ]; then continue; fi",
            "  cp -f \"$f\" \"$dst/$name\"",
            "  codesign --force --sign \"${EXPANDED_CODE_SIGN_IDENTITY:--}\" --timestamp=none \"$dst/$name\"",
            "done",
            "",
          ],
        },
      ],

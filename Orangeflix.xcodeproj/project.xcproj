            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libbrotlidec.1.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libcrypto.4.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libdav1d.7.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libfontconfig.1.dylib",
            "$(TARGET_BUILD_DIR)/$(FRAMEWORKS_FOLDER_PATH)/libfreetype.6.dylib",
